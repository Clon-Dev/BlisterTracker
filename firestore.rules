rules_version = '2';

// Data model
//   accounts/{uid}                  private per-device account: { pid, subs: [pid], tokens: [fcmToken] }
//   users/{pid}                     public-ish profile + schedule, readable by owner and subscribers
//   users/{pid}/private/auth        { key } = sha256("<pid>:<password>"), owner only
//   users/{pid}/subscribers/{uid}   { key } — creatable only by presenting the matching key
//   users/{pid}/seen/{uid}          { day, at, name? } — a follower confirms they saw that the pill was taken
//   usernames/{key}                 { pid, ownerUid, username } — unique, changeable username of a profile;
//                                   key = usernameKey(username) (lower case, "%" and "/" escaped), as in src/data.ts
//
// The Cloudflare worker uses a service account and bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    // Email accounts only.
    function signedIn() { return request.auth != null && request.auth.token.email is string; }
    function userDoc(pid) { return /databases/$(database)/documents/users/$(pid); }
    function ownsUser(pid) { return signedIn() && get(userDoc(pid)).data.ownerUid == request.auth.uid; }

    function isDay(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function usernameKey(u) { return u.lower().replace('%', '%25').replace('/', '%2F'); }
    // The key of a username. lower() here only lowercases A–Z, so for names with other letters (ä, Ж, Σ, …) the app's
    // Unicode lowercasing can't be recomputed: then the key must at least have the same length, no capitals A–Z,
    // and the same escaping. Pure ASCII names are checked exactly.
    function keyFits(u, key) {
      return usernameKey(u) == key
        || (u.matches('.*[^!-~].*') && key.size() == usernameKey(u).size() && key.lower() == key && !key.matches('.*[/].*'));
    }
    // 2 to 24 characters: ASCII 33–126, accented Latin, Greek, Cyrillic, Hiragana, Katakana (as in src/data.ts).
    // "__…__" and dot-only IDs are reserved by Firestore.
    function validUsername(u) {
      return u is string && u.matches('^[!-~À-ÖØ-öø-ɏͰ-ϿЀ-ԯḀ-ỿ぀-ヿ]{2,24}$') && !u.matches('^__.*__$') && !u.matches('^[.]+$');
    }
    // The profile's username (and its key) may only change to an entry this profile holds (claimed in the same batch).
    // Profiles from version 1.4.0 have no usernameKey yet (ASCII names only, so it can be computed).
    function usernameUnchangedOrOwned(pid) {
      let d = request.resource.data;
      return (d.get('username', null) == resource.data.get('username', null) && d.get('usernameKey', null) == resource.data.get('usernameKey', null))
        || (validUsername(d.username) && entryHolds(pid, d.username, d.get('usernameKey', usernameKey(d.username))));
    }
    function entryHolds(pid, name, key) {
      let entry = getAfter(/databases/$(database)/documents/usernames/$(key)).data;
      return entry.pid == pid && entry.username == name;
    }
    // See shared/schedule.ts for the meaning of the fields.
    function validSchedule(d) {
      return d.keys().hasOnly(['ownerUid', 'name', 'pillsPerPack', 'placebo', 'breakDays', 'packStart', 'trackingSince',
                               'time', 'tz', 'repeatMinutes', 'lateMinutes', 'takenDays',
                               'nextReminderAt', 'nextLateAt', 'takenPending',
                               'earlierPackStarts', 'supplyPacks', 'supplyFrom', 'appointmentDay', 'appointmentNote',
                               'reminderText', 'nextNoticeAt', 'shareKeyWrap', 'username', 'usernameKey', 'method'])
        && d.name is string && d.name.size() <= 30
        // Pill pack, patch / ring wear weeks (21 or 42 days), or the injection interval (56, 84 or 91 days).
        && d.pillsPerPack is int && d.pillsPerPack >= 1 && d.pillsPerPack <= 91
        && d.placebo is int && d.placebo >= 0 && d.placebo < d.pillsPerPack
        && d.breakDays is int && d.breakDays >= 0 && d.breakDays <= 14
        && isDay(d.packStart) && isDay(d.trackingSince)
        && d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.tz is string && d.tz.size() <= 64
        && d.repeatMinutes in [0, 15, 30, 60]
        && d.lateMinutes in [0, 30, 60, 120]
        && d.takenDays is map && d.takenDays.size() <= 5000
        && d.nextReminderAt is timestamp
        && (d.nextLateAt == null || d.nextLateAt is timestamp)
        && d.takenPending is bool
        // Optional (added later; older schedules don't have them).
        && (!('earlierPackStarts' in d) || (d.earlierPackStarts is list && d.earlierPackStarts.size() <= 100))
        && (!('supplyPacks' in d) || (d.supplyPacks is int && d.supplyPacks >= 0 && d.supplyPacks <= 24))
        && (!('supplyFrom' in d) || isDay(d.supplyFrom))
        && (!('appointmentDay' in d) || d.appointmentDay == null || isDay(d.appointmentDay))
        // Encrypted (v1:…) since the encryption update, hence longer than the 80 characters typed.
        && (!('appointmentNote' in d) || (d.appointmentNote is string && d.appointmentNote.size() <= 400))
        && (!('shareKeyWrap' in d) || (d.shareKeyWrap is string && d.shareKeyWrap.size() <= 512))
        // 64 characters in the app; emoji can take several UTF-16 units each.
        && (!('reminderText' in d) || (d.reminderText is string && d.reminderText.size() <= 256))
        && (!('nextNoticeAt' in d) || d.nextNoticeAt == null || d.nextNoticeAt is timestamp)
        // Missing: the pill (schedules from before the other methods).
        && (!('method' in d) || d.method in ['pill', 'patch', 'ring', 'injection']);
    }

    match /accounts/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pid', 'subs', 'tokens', 'lang', 'keyring', 'followerOnly'])
        && (!('followerOnly' in request.resource.data) || request.resource.data.followerOnly is bool)
        // Encryption keyring (wrapped keys only; see src/keys.ts).
        && (!('keyring' in request.resource.data) || (request.resource.data.keyring is map && request.resource.data.keyring.size() <= 8))
        && (!('lang' in request.resource.data) || request.resource.data.lang in ['en', 'de'])
        && request.resource.data.pid is string
        && request.resource.data.subs is list && request.resource.data.subs.size() <= 20
        && request.resource.data.tokens is list && request.resource.data.tokens.size() <= 5;
    }

    // Usernames: any signed-in user can look one up (to follow); claiming one works only while it's free.
    match /usernames/{key} {
      function validEntry(d) {
        return d.keys().hasOnly(['pid', 'ownerUid', 'username']) && d.ownerUid == request.auth.uid
          && validUsername(d.username) && keyFits(d.username, key);
      }
      allow read: if signedIn();
      allow create: if signedIn() && validEntry(request.resource.data)
        && getAfter(userDoc(request.resource.data.pid)).data.ownerUid == request.auth.uid;
      // Same name with other capitals: the entry stays, with the new spelling.
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && validEntry(request.resource.data) && request.resource.data.pid == resource.data.pid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /users/{pid} {
      allow create: if signedIn()
        && pid.matches('^[A-HJKMNP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && usernameUnchangedOrOwned(pid)
        && (validSchedule(request.resource.data)
          // Profile without a schedule yet: only the share-key wrap (sharing password set first) and the username.
          || (request.resource.data.keys().hasOnly(['ownerUid', 'shareKeyWrap', 'username', 'usernameKey'])
            && (!('shareKeyWrap' in request.resource.data)
              || (request.resource.data.shareKeyWrap is string && request.resource.data.shareKeyWrap.size() <= 512))));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid
        || exists(/databases/$(database)/documents/users/$(pid)/subscribers/$(request.auth.uid)));

      // { key: sha256("<pid>:<password>"), password }: owner only. The plain password lets the owner look it up again;
      // followers only ever present the key.
      match /private/auth {
        allow read, delete: if ownsUser(pid);
        allow create, update: if ownsUser(pid)
          && request.resource.data.keys().hasOnly(['key', 'password'])
          && request.resource.data.key is string && request.resource.data.key.size() == 64
          // The owner's copy of the password, encrypted with their data key (v1:…).
          && (!('password' in request.resource.data) || (request.resource.data.password is string && request.resource.data.password.size() <= 512));
      }

      // Daily notes: "shared" is readable by followers, "private" only by the owner.
      // { days: { "YYYY-MM-DD": { text, mood } } }
      match /notes/{which} {
        allow read: if ownsUser(pid) || (which == 'shared' && signedIn()
          && exists(/databases/$(database)/documents/users/$(pid)/subscribers/$(request.auth.uid)));
        allow delete: if ownsUser(pid);
        allow create, update: if ownsUser(pid) && which in ['shared', 'private']
          && request.resource.data.keys().hasOnly(['days'])
          && request.resource.data.days is map && request.resource.data.days.size() <= 5000;
      }

      match /subscribers/{subUid} {
        // Presenting the right key is the password check: the key itself is never readable by subscribers.
        allow create, update: if signedIn() && subUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['key'])
          && request.resource.data.key == get(/databases/$(database)/documents/users/$(pid)/private/auth).data.key
          && get(userDoc(pid)).data.ownerUid != request.auth.uid;
        allow read, delete: if signedIn() && (subUid == request.auth.uid || ownsUser(pid));
      }

      // "Seen" confirmations (like a read receipt): only current followers write their own; the owner reads them.
      match /seen/{subUid} {
        allow create, update: if signedIn() && subUid == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(pid)/subscribers/$(request.auth.uid))
          && request.resource.data.keys().hasOnly(['day', 'at', 'name'])
          && isDay(request.resource.data.day)
          && request.resource.data.at == request.time
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 30));
        allow read, delete: if signedIn() && (subUid == request.auth.uid || ownsUser(pid));
      }
    }
  }
}
